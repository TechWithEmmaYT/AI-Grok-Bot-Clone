# Server-only — never prefixed with EXPO_PUBLIC_.

# Neon Postgres pooled connection string.
# Neon console -> your project -> Connection string -> Pooled connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

BETTER_AUTH_SECRET=

# Origin the auth server is reachable at. LAN IP for a physical device.
BETTER_AUTH_URL=http://localhost:8081

# Social providers — fill in when configured (phase 2b).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Public: safe to ship in the client bundle.
EXPO_PUBLIC_API_URL=http://localhost:8081

# Vercel AI Gateway — routes model calls so the provider can change without
# a new key. Dashboard -> AI Gateway -> API keys.
AI_GATEWAY_API_KEY=
# Optional: override the model slug used by the chat agent.
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5

# Trigger.dev development key. Dashboard -> your project -> API keys.
TRIGGER_SECRET_KEY=
AI_SUMMARY_MODEL=anthropic/claude-haiku-4.5
